{
  "name": "@substrate-system/image-editor",
  "type": "module",
  "version": "0.0.5",
  "files": [
    "./dist/*"
  ],
  "scripts": {
    "lint": "eslint \"./**/*.{ts,js}\"",
    "test": "esbuild ./test/index.ts --bundle | node scripts/run-tests.mjs",
    "test:css": "node test/css.mjs",
    "build-css": "node scripts/build-css.mjs",
    "build-css:min": "node scripts/build-css.mjs --minify",
    "build-cjs": "esbuild src/*.ts --format=cjs --keep-names --tsconfig=tsconfig.build.json --outdir=./dist --out-extension:.js=.cjs --sourcemap",
    "build-cjs:min": "npm run build-cjs -- --minify --out-extension:.js=.min.cjs",
    "build-esm": "esbuild src/*.ts --format=esm --metafile=dist/meta.json --keep-names --tsconfig=tsconfig.build.json --outdir=./dist --sourcemap && tsc --emitDeclarationOnly --project tsconfig.build.json --outDir dist",
    "build-esm:min": "esbuild ./src/*.ts --format=esm --keep-names --bundle --tsconfig=tsconfig.build.json --minify --out-extension:.js=.min.js --outdir=./dist --sourcemap",
    "build-example": "mkdir -p ./public && rm -rf ./public/* && NODE_ENV=development vite --mode staging --base=\"/image-editor\" build",
    "clean": "mkdir -p ./dist && rm -rf ./dist/*",
    "build:cjs": "npm run build-cjs && npm run build-cjs:min",
    "build:esm": "npm run build-esm && npm run build-esm:min",
    "build:js": "npm run build:cjs && npm run build:esm",
    "build:css": "npm run build-css && npm run build-css:min",
    "build:artifacts": "npm run build:js && npm run build:css",
    "build": "npm run clean && npm run build:artifacts",
    "start": "vite",
    "toc": "markdown-toc --maxdepth 3 -i README.md",
    "preversion": "npm run lint && stylelint src/*.css",
    "version": "npm run toc && auto-changelog -p --template keepachangelog --breaking-pattern 'BREAKING CHANGE:' && git add CHANGELOG.md README.md",
    "postversion": "git push --follow-tags && npm publish",
    "prepublishOnly": "npm run build"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./css": "./dist/index.css",
    "./min/css": "./dist/index.min.css",
    "./min/*": {
      "import": "./dist/*.min.js",
      "require": "./dist/*.min.cjs"
    },
    "./*": {
      "import": "./dist/*.js",
      "require": "./dist/*.cjs"
    }
  },
  "dependencies": {
    "@substrate-system/debug": "^0.9.60",
    "@substrate-system/web-component": "^0.0.59"
  },
  "devDependencies": {
    "@substrate-system/dialog": "^0.0.32",
    "@substrate-system/dom": "^0.1.13",
    "@substrate-system/signs": "^0.2.4",
    "@substrate-system/tapout": "^0.0.41",
    "@substrate-system/tapzero": "^0.10.16",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "auto-changelog": "^2.4.0",
    "browserslist": "^4.28.1",
    "esbuild": "^0.28.0",
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.1.0",
    "lightningcss": "^1.30.2",
    "lightningcss-cli": "^1.30.2",
    "markdown-toc": "^1.2.0",
    "playwright": "^1.54.2",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "tap-spec": "^5.0.0",
    "typedoc": "^0.28.1",
    "typescript": "^7.0.2",
    "vite": "^8.0.5"
  },
  "author": "nichoth <nichoth@nichoth.com> (https://nichoth.com)",
  "license": "SEE LICENSE IN LICENSE"
}
